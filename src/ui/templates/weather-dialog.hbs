{{!-- Weather dialog template --}}
<form class="dnd-weather-dialog">
  <div class="dialog-content">
    <div class="weather-controls">
        <div class="form-group">
            <label>Month:</label>
            <select name="month" {{#if loading}}disabled{{/if}}>
                {{#each months}}
                    <option value="{{this}}" {{#if (eq ../selectedMonth this)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>

        <div class="form-group">
            <label>Day:</label>
            <input type="number" name="day" value="{{selectedDay}}" min="1" max="28" {{#if loading}}disabled{{/if}}>
        </div>

        <div class="form-group">
            <label>Latitude:</label>
            <input type="number" name="latitude" value="{{latitude}}" min="0" max="90" {{#if loading}}disabled{{/if}}>
        </div>

        <div class="form-group">
            <label>Terrain:</label>
            <select name="terrain" {{#if loading}}disabled{{/if}}>
                {{#each terrainTypes}}
                    <option value="{{this}}" {{#if (eq this ../terrain)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>

        <div class="form-group">
            <label>Elevation (ft):</label>
            <input type="number" name="elevation" value="{{elevation}}" min="0" step="100" {{#if loading}}disabled{{/if}}>
        </div>
    </div>

    {{!-- Weather Controls --}}
    <div class="dialog-buttons">
        <button type="button" class="generate-weather" {{#if loading}}disabled{{/if}}>
            Generate New Weather
        </button>
        
        {{#if isGM}}
        <button type="button" class="update-weather" {{#if loading}}disabled{{/if}}>
            Update Weather
        </button>
        <button type="button" class="settings" {{#if loading}}disabled{{/if}}>
            Settings
        </button>
        {{/if}}

        <button type="button" class="refresh-weather" {{#if loading}}disabled{{/if}}>
            Refresh
        </button>
    </div>

    <!-- Add to weather-dialog.hbs -->
    {{#if weather}}
    <div class="current-weather-summary">
    <h3>Current Weather</h3>
    <div class="weather-status {{#if weather.precipitation.continues}}continuing{{/if}}">
        <div class="weather-icon">
        <i class="fas {{weatherIcon weather.conditions weather.precipitation.type}}"></i>
        </div>
        <div class="weather-text">
        <span class="weather-condition">{{weather.conditions}}</span>
        {{#if weather.precipitation.type}}
            <span class="precipitation-type">{{weather.precipitation.type}}</span>
        {{/if}}
        {{#if weather.precipitation.continues}}
            <span class="continuation-indicator">
            <i class="fas fa-sync-alt"></i> Continuing
            </span>
        {{/if}}
        </div>
    </div>
    </div>
    {{/if}}

    {{debug weatherDuration}}
    {{debug weather.precipitation.duration}}

    <!-- Weather Duration Section -->
    <!-- Always show this section -->
    <div class="weather-duration-section">
        <h3>Weather Duration</h3>
        <p id="weatherDuration">
            {{#if weather.precipitation.duration}}
                {{#if weather.precipitation.duration}}
                    Weather event duration: {{formatDuration weather.precipitation.duration}}
                    {{#if weather.weatherTiming.remaining}}
                        ({{weather.weatherTiming.remaining}} remaining)
                    {{/if}}
                {{else}}
                    Weather event duration: Not applicable (clear weather)
                {{/if}}
            {{else}}
                Weather event duration: Not applicable (clear weather)
            {{/if}}
        </p>
    </div>

    <!-- Add to weather-dialog.hbs -->
    {{#if weather.precipitation.continues}}
    <div class="weather-timeline">
    <div class="timeline-point previous">
        <span class="time-label">Previous</span>
        <span class="weather-type">{{weather.precipitation.previousType}}</span>
    </div>
    <div class="timeline-connector {{#if weather.precipitation.changed}}changed{{/if}}">
        <i class="fas fa-long-arrow-alt-right"></i>
    </div>
    <div class="timeline-point current">
        <span class="time-label">Current</span>
        <span class="weather-type">{{weather.precipitation.type}}</span>
    </div>
    <div class="timeline-duration">
        <i class="fas fa-clock"></i>
        {{formatDuration weather.precipitation.duration}}
    </div>
    </div>
    {{/if}}

    <!-- Add to weather-dialog.hbs -->
    <div class="weather-history-section">
    <button type="button" class="collapse-toggle">
        <i class="fas fa-history"></i> Weather History
        <i class="fas fa-chevron-down"></i>
    </button>
    <div class="weather-history-content collapsed">
        <ul class="weather-history-list">
        {{#each weatherHistory}}
        <li class="weather-history-item">
            <span class="history-time">{{this.timestamp}}</span>
            <span class="history-condition">{{this.baseConditions.sky}}</span>
            <span class="history-precipitation">{{this.baseConditions.precipitation.type}}</span>
            <button type="button" class="restore-weather" data-index="{{@index}}">
            <i class="fas fa-undo"></i>
            </button>
        </li>
        {{/each}}
        </ul>
    </div>
    </div>

    <!-- Add to weather-dialog.hbs -->
    {{#if isGM}}
    <div class="weather-override-section">
    <button type="button" class="collapse-toggle">
        <i class="fas fa-sliders-h"></i> Weather Controls
        <i class="fas fa-chevron-down"></i>
    </button>
    <div class="weather-override-content collapsed">
        <div class="override-form">
        <div class="form-row">
            <label for="override-precipitation">Precipitation:</label>
            <select id="override-precipitation">
            <option value="none">None</option>
            {{#each precipitationTypes}}
                <option value="{{this}}">{{this}}</option>
            {{/each}}
            </select>
        </div>
        
        <div class="form-row">
            <label for="override-duration">Duration (hours):</label>
            <input type="number" id="override-duration" min="1" max="72" value="4">
        </div>
        
        <div class="form-row">
            <label>
            <input type="checkbox" id="override-continuation">
            Mark as continuation
            </label>
        </div>
        
        <div class="form-row">
            <label for="override-previous-type" class="conditional-field">
            Previous Type:
            </label>
            <select id="override-previous-type" class="conditional-field">
            <option value="none">None</option>
            {{#each precipitationTypes}}
                <option value="{{this}}">{{this}}</option>
            {{/each}}
            </select>
        </div>
        
        <button type="button" class="apply-override">
            Apply Weather Override
        </button>
        </div>
    </div>
    </div>
    {{/if}}

    {{!-- Debug info section --}}
    {{#if error}}
    <div class="error-message" style="color: red; margin-top: 10px;">
        Error: {{error}}
    </div>
    {{/if}}

    {{#if debugMode}}
    <div class="debug-info" style="margin-top: 10px; font-size: 0.8em; color: #666;">
        Available Months: {{#each months}}{{this}}, {{/each}}<br>
        Selected Month: {{selectedMonth}}<br>
        Latitude: {{latitude}}<br>
        Terrain: {{terrain}}<br>
        Elevation: {{elevation}}
    </div>
    {{/if}}
  </div>
</form>