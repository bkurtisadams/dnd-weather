{{!-- Compact Weather Display Template --}}
<div class="weather-current {{#if loading}}loading{{/if}}">
  <div class="weather-report">
    <div class="report-header">
      <h2>📜 Greyhawk Weather Report</h2>
      <div class="location-info">
        <span>📍 <strong>Location</strong>: {{#if locationName}}{{locationName}}{{else}}{{terrain}}{{/if}}</span>
        <span>📅 <strong>Date</strong>: {{#if currentDate}}{{currentDate}}{{else}}{{selectedMonth}} {{selectedDay}}{{/if}}</span>
        <span>🌍 <strong>Latitude</strong>: {{latitude}}° North</span>
        <span>🏔 <strong>Terrain</strong>: {{terrain}}</span>
      </div>
    </div>

    <div class="report-section">
      <h3>🌡 Temperature</h3>
      <ul class="info-list">
        <li><strong>Daily High</strong>: {{weather.temperature}}°F</li>
        <li><strong>Daily Low</strong>: {{weather.temperatureLow}}°F</li>
        {{#if weather.windChill}}
          <li><strong>Wind Chill Factor</strong>: Feels like {{weather.windChill}}°F</li>
        {{/if}}
      </ul>
    </div>

    <div class="report-section">
      <h3>💨 Wind</h3>
      <ul class="info-list">
        <li><strong>Speed</strong>: {{weather.wind}} mph</li>
        <li><strong>Direction</strong>: {{weather.windDirection}}</li>
        <li><strong>Effects</strong>: {{#if (gt weather.wind 30)}}Impairs movement and ranged attacks{{else}}No major impact on movement{{/if}}</li>
      </ul>
    </div>

    <div class="report-section">
      <h3>☁ Sky Conditions</h3>
      <ul class="info-list">
        <li><strong>{{weather.conditions}}</strong></li>
      </ul>
    </div>

    <div class="report-section">
      <h3>🌧 Precipitation</h3>
      {{#if (eq weather.precipitation.type 'none')}}
        <ul class="info-list">
          <li><strong>None</strong></li>
        </ul>
      {{else}}
        <ul class="info-list">
          <li>
            <strong>{{weather.precipitation.type}}</strong>
            {{#if weather.precipitation.amount}} ({{weather.precipitation.amount}} in.){{/if}}
            lasting <strong>{{formatDuration weather.precipitation.duration}}</strong>
          </li>
          <li><strong>Chance of Continuation</strong>: {{weather.precipitation.chanceContinuing}}%</li>
          {{#if weather.precipitation.continues}}
            <li><strong>Weather Change</strong>: 
              {{#if weather.precipitation.changed}}
                {{weather.precipitation.previousType}} → {{weather.precipitation.type}}
              {{/if}}
            </li>
          {{/if}}
        </ul>
      {{/if}}
    </div>

    <div class="report-section">
      <h3>🌙 Moon Phases</h3>
      <ul class="info-list">
        <li>
          <strong>Luna</strong>: {{weather.moonPhase.luna}}
          <i class="fas {{getMoonIcon weather.moonPhase.luna}} moon-icon"></i>
        </li>
        <li>
          <strong>Celene</strong>: {{weather.moonPhase.celene}}
          <i class="fas {{getMoonIcon weather.moonPhase.celene}} moon-icon celene"></i>
        </li>
      </ul>
    </div>

    <div class="report-section">
      <h3>🌄 Sunrise & Sunset</h3>
      <ul class="info-list">
        <li><strong>Sunrise</strong>: {{weather.daylight.sunrise}}</li>
        <li><strong>Sunset</strong>: {{weather.daylight.sunset}}</li>
      </ul>
    </div>

    {{#if (neq weather.precipitation.type 'none')}}
      <div class="report-section">
        <h3>🚶 Travel Effects</h3>
        <ul class="info-list">
          <li><strong>Visibility</strong>: {{weather.precipitation.vision}}</li>
          <li>
            <strong>Movement Reduction</strong>: 
            {{#if (isObject weather.precipitation.movement)}}
              Foot: {{weather.precipitation.movement.foot}} · 
              Horse: {{weather.precipitation.movement.horse}} · 
              Cart: {{weather.precipitation.movement.cart}}
            {{else}}
              {{weather.precipitation.movement}}
            {{/if}}
          </li>
          {{#if weather.precipitation.tracking}}
            <li><strong>Tracking Penalty</strong>: {{weather.precipitation.tracking}}</li>
          {{/if}}
          {{#if weather.precipitation.chanceLost}}
            <li><strong>Chance of Getting Lost</strong>: {{weather.precipitation.chanceLost}}</li>
          {{/if}}
        </ul>
      </div>
    {{/if}}

  {{!-- Look for the "Special Events" section in your template --}}
  <div class="report-section">
    <h3>🌈 Special Events</h3>
    <ul class="info-list">
      {{#if weather.precipitation.rainbowOccurred}}
        <li class="rainbow-event">
          <i class="fas fa-rainbow rainbow-icon"></i>
          <strong>Rainbow Event:</strong> {{weather.precipitation.rainbowType}}
        </li>
      {{else if (neq weather.precipitation.type 'none')}}
        {{#if (gt weather.precipitation.chanceRainbow 0)}}
          <li>
            <strong>Rainbow Chance:</strong> {{weather.precipitation.chanceRainbow}}%
          </li>
        {{/if}}
      {{/if}}
      {{#if effects.special.length}}
        {{#each effects.special}}
          <li>{{this}}</li>
        {{/each}}
      {{/if}}
      {{#if (and (not weather.precipitation.rainbowOccurred) 
                (or (eq weather.precipitation.type 'none') (eq weather.precipitation.chanceRainbow 0)) 
                (eq effects.special.length 0))}}
        <li><em>No special weather events occurring</em></li>
      {{/if}}
    </ul>
  </div>
    
  {{!-- Weather History Section --}}
  <div class="history-section">
    <h3>📝 Weather History</h3>
    {{#if weatherHistory.length}}
      <div class="history-list">
        {{#each weatherHistory as |history index|}}
          {{#if (lt index 5)}}
          <div class="history-item">
            <span class="history-time">{{history.timestamp}}</span>
            <span class="history-details">
              <i class="fas {{weatherIcon history.baseConditions.sky history.baseConditions.precipitation.type}}"></i>
              {{history.baseConditions.sky}}
              {{#unless (eq history.baseConditions.precipitation.type "none")}}
                · {{history.baseConditions.precipitation.type}}
              {{/unless}}
            </span>
            {{#if ../isGM}}
              <button type="button" class="restore-weather" data-index="{{index}}" title="Restore this weather">
                <i class="fas fa-undo"></i>
              </button>
            {{/if}}
          </div>
          {{/if}}
        {{/each}}
      </div>
    {{else}}
      <div class="empty-history">No previous weather records available.</div>
    {{/if}}
  </div>
</div>